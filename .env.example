# Copy to .env and fill in. Never commit .env.
# config.py is the only module that reads these.

# --- Competition -------------------------------------------------------------
# Team number from organizers -> subject "Team # {TEAM_NO} - Hotel Reservation Confirmed!"
TEAM_NO=
# Name the agent books under
GUEST_NAME=
# Where the confirmation receipt is sent
RECEIPT_TO_EMAIL=

# --- WS1: Search (search_service.py) ------------------------------------------
SERPAPI_API_KEY=
# Optional: phone lookup via Google Places if SerpApi hotel results lack phones
GOOGLE_PLACES_API_KEY=
# Default currency and search size
SEARCH_CURRENCY=CAD
SEARCH_TOP_N=5

# --- WS2: Backboard (agent_brain.py) ------------------------------------------
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=
# Fastest cheap model from the Phase 0 latency test
BACKBOARD_MODEL=
# Hard cap per session (see docs/architecture.md token strategy)
BACKBOARD_TOKEN_BUDGET=1200

# --- WS3: ElevenLabs voice (voice_agent.py) -----------------------------------
ELEVENLABS_API_KEY=
# Booking agent that places the outbound call
ELEVENLABS_AGENT_ID=
# Phone number imported into ElevenLabs (Twilio or SIP trunk)
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Used to verify post-call webhook signatures
ELEVENLABS_WEBHOOK_SECRET=
# Mock hotel agent for testing (E.164, e.g. +14165550123)
MOCK_HOTEL_PHONE=
# Set true to dial MOCK_HOTEL_PHONE instead of real search results
USE_MOCK_HOTEL=true
# Failover thresholds (seconds)
NO_HUMAN_TIMEOUT_S=45
MAX_CALL_DURATION_S=240

# --- WS4: Email + tool endpoint (email_service.py) ----------------------------
# resend | smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Gmail SMTP fallback (use an app password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# Public URL of the record_confirmation endpoint (cloudflared/ngrok/deploy)
PUBLIC_BASE_URL=
# Shared secret the ElevenLabs server tool sends with each call
TOOL_SHARED_SECRET=
