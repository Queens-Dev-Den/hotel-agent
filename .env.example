# Copy to .env and fill in. Never commit .env.
# config.py is the only module that reads these.

# --- Competition -------------------------------------------------------------
# Team number from organizers -> subject "Team # {TEAM_NO} - Hotel Reservation Confirmed!"
TEAM_NO=
# Where the availability email (with call transcripts) is sent
RECEIPT_TO_EMAIL=
# Modules swapped for mocks.py fixtures while a branch is late, e.g. search,brain,voice,email (empty = all real)
MOCK_MODULES=

# --- WS1: Search (search_service.py) ------------------------------------------
SERPAPI_API_KEY=
# Optional: phone lookup via Google Places if SerpApi hotel results lack phones
GOOGLE_PLACES_API_KEY=
# Default currency and search size
SEARCH_CURRENCY=CAD
# Cheapest hotels that get a phone/address lookup (1 SerpApi credit each)
SEARCH_TOP_N=5
# Callable hotels kept after filtering (contract max 3)
MAX_CANDIDATES=3
# Airbnb-style rentals: searched too, but they rarely list a phone (~3 credits/run)
SEARCH_RENTALS=true
RENTAL_FANOUT=2
HTTP_TIMEOUT_S=10
# 1 = replay raw API responses from .cache/ in dev (saves credits). 0 for the demo.
SEARCH_CACHE=0

# --- WS2: Backboard (agent_brain.py) ------------------------------------------
BACKBOARD_API_KEY=
BACKBOARD_BASE_URL=https://app.backboard.io/api
# "<llm_provider>/<model_name>", fastest cheap model from the Phase 0 latency test
BACKBOARD_MODEL=google/gemini-2.5-flash-lite
# Hard cap per session (see docs/architecture.md token strategy)
BACKBOARD_TOKEN_BUDGET=1200
# Memory assistant id (printed by agent_brain on first run; share it with the team)
BACKBOARD_ASSISTANT_ID=

# --- WS3: ElevenLabs voice (voice_agent.py) -----------------------------------
ELEVENLABS_API_KEY=
# Booking agent that places the outbound call
ELEVENLABS_AGENT_ID=
# Phone number imported into ElevenLabs (Twilio or SIP trunk)
ELEVENLABS_AGENT_PHONE_NUMBER_ID=
# Used to verify post-call webhook signatures
ELEVENLABS_WEBHOOK_SECRET=
# Mock hotel numbers for testing (E.164, comma-separated, one per parallel call)
MOCK_HOTEL_PHONES=
# Set true to dial MOCK_HOTEL_PHONES instead of real search results
USE_MOCK_HOTEL=true
# Call limits (seconds). All 3 calls run at the same time; there is no failover.
NO_HUMAN_TIMEOUT_S=45
MAX_CALL_DURATION_S=180
# Concurrent outbound calls (one per candidate)
MAX_PARALLEL_CALLS=3

# --- WS4: Email + tool endpoint (email_service.py) ----------------------------
# resend | smtp
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
# Gmail SMTP fallback (use an app password, not your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
# Public URL of the record_availability endpoint (cloudflared/ngrok/deploy)
PUBLIC_BASE_URL=
# Shared secret the ElevenLabs server tool sends with each call
TOOL_SHARED_SECRET=
# Local port the tool server listens on (ngrok forwards to it)
TOOL_SERVER_PORT=8000
